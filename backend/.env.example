# Entorno y aplicación
APP_ENV=development
APP_NAME=IT seobiseu API
API_PREFIX=/api/v1
FRONTEND_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# Base de datos Supabase (PostgreSQL Cloud)
# Obtenidos en Supabase Dashboard -> Project Settings -> API y Database
DATABASE_MODE=supabase
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_KEY=tu-anon-key-o-service-role-key
SUPABASE_DB_URL=postgresql+pg8000://postgres.tu_ref:tu_password@aws-0-tu-region.pooler.supabase.com:6543/postgres

# Seguridad y Autenticación JWT
JWT_SECRET_KEY=cambiar_por_una_clave_larga_aleatoria_de_al_menos_32_caracteres
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=60
